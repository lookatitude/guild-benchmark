# Node
node_modules/
ui/node_modules/
*.log

# Build output
ui/dist/
*.tsbuildinfo

# Test / runtime artifacts
runs/
reports/internal/
coverage/
ui/coverage/

# .guild/ — share-dot-guild policy (see docs/knowledge/decisions/guild-boundary-config-and-tracking.md Decision E)
.guild
!/.guild/
!.guild/wiki/
!.guild/wiki/**
!.guild/initiatives/
!.guild/initiatives/**
!.guild/spec/
!.guild/spec/**
!.guild/plan/
!.guild/plan/**
!.guild/prd/
!.guild/prd/**
!.guild/team/
!.guild/team/**
!.guild/reflections/
!.guild/reflections/**
!.guild/evolve/
!.guild/evolve/**
!.guild/indexes/
!.guild/indexes/**
!.guild/workspace.json
!.guild/settings.json
!.guild/runs/
!.guild/runs/*/
# Re-deny everything inside runs/<id>/ — FU-C: tighten to named-files-only.
# Previously un-ignoring runs/<id>/ as a dir let any file through (run-state.json,
# ad-hoc receipts). Now only the named handoffs/+files/dirs below are shared.
.guild/runs/*/**
!.guild/runs/*/handoffs/
!.guild/runs/*/handoffs/**
!.guild/runs/*/verify.md
!.guild/runs/*/review.md
!.guild/runs/*/provenance.json
!.guild/runs/*/run.yaml
!.guild/runs/*/summary.md
!.guild/runs/*/share-payloads.flag

# Re-deny operator-private / local-only sub-paths (D-SHR-4 + Decision G)
.guild/settings.local.json
.guild/hosts/

# .claude/ — Claude Code config (FU-D: dev-team agents + settings.json default
# to tracked when explicitly added; settings.local.json holds the operator's
# permission allowlist and stays local). Content commit (`git add .claude/...`)
# is a separate operator action — agents/ has drifted across workspace + plugin
# and wants reconciliation first.
.claude/settings.local.json

# Benchmark fixture .guild dirs — static test data, not live runtime state
!fixtures/**/.guild/
!fixtures/**/.guild/**
# Fixtures also live under tests/fixtures/; the unanchored `runs/` rule (above)
# was eating their .guild/runs/ trees. Un-ignore all tests/fixtures test data.
!tests/fixtures/**

# OS
.DS_Store
